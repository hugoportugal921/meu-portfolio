{
  "name": "AtlasBI",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "pt-BR",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "expressions": [
      {
        "name": "Fontes",
        "kind": "m",
        "expression": [
          "[",
          "    Vendas = Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.GZip),",
          "    Metas = Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.GZip),",
          "    Unidades = Binary.Decompress(Binary.FromText(\"H4sIAAAAAAACAwvNy0xJTEn1dNEJhbB0glLTMxPzuQx1gg8vzlcISCzNydcJLk1JLS5J5TICyiZnpqXq+OUXQUSMdZxLizJLMpMSgYpyuEx0nFJz8hU88osyq/LzSlLhOgFeOfcJaAAAAA==\", BinaryEncoding.Base64), Compression.GZip),",
          "    Produtos = Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.GZip),",
          "    Canais = Binary.Decompress(Binary.FromText(\"H4sIAAAAAAACA3NOzEvM8XTRcQbRXIY6Yal5KYkKKZlFqSWJXEY6PvlZiQr5eTmZealcxjoBiUXJqZlF+cVcAAAxUAM3AAAA\", BinaryEncoding.Base64), Compression.GZip),",
          "    Calendario = Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.GZip),",
          "    Acessos = Binary.Decompress(Binary.FromText(\"H4sIAAAAAAACA3PNTczM0QnNy0xJTEn1dOFKzEvMySwuSdQrLnBIrUjMLchJ1UvOz9UxRMgUpSZnpqWiyBpxpacCpfLRtGARxKrSGJugCRcAOstU3pwAAAA=\", BinaryEncoding.Base64), Compression.GZip)",
          "]"
        ]
      },
      {
        "name": "fxLerCsv",
        "kind": "m",
        "expression": [
          "(nome as text) as table =>",
          "let",
          "    Conteudo = Record.Field(Fontes, nome),",
          "    CSV = Csv.Document(Conteudo, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
          "    Cabecalhos = Table.PromoteHeaders(CSV, [PromoteAllScalars=true])",
          "in",
          "    Cabecalhos"
        ]
      },
      {
        "name": "stgVendas",
        "kind": "m",
        "expression": [
          "let",
          "    Fonte = fxLerCsv(\"Vendas\"),",
          "    Textos = Table.TransformColumns(Fonte, {{\"ItemID\", Text.Trim, type text}, {\"PedidoID\", Text.Trim, type text}}),",
          "    Tipos = Table.TransformColumns(Textos, {",
          "        {\"DataVenda\", each try Date.FromText(_, [Format=\"yyyy-MM-dd\", Culture=\"en-US\"]) otherwise null, type nullable date},",
          "        {\"ProdutoID\", each try Int64.From(Number.FromText(_, \"en-US\")) otherwise null, Int64.Type},",
          "        {\"UnidadeID\", each try Int64.From(Number.FromText(_, \"en-US\")) otherwise null, Int64.Type},",
          "        {\"CanalID\", each try Int64.From(Number.FromText(_, \"en-US\")) otherwise null, Int64.Type},",
          "        {\"Quantidade\", each try Int64.From(Number.FromText(_, \"en-US\")) otherwise null, Int64.Type},",
          "        {\"PrecoUnitario\", each try Currency.From(_, \"en-US\") otherwise null, Currency.Type},",
          "        {\"CustoUnitario\", each try Currency.From(_, \"en-US\") otherwise null, Currency.Type},",
          "        {\"Desconto\", each try Currency.From(_, \"en-US\") otherwise null, Currency.Type}",
          "    })",
          "in",
          "    Tipos"
        ]
      },
      {
        "name": "vendasValidas",
        "kind": "m",
        "expression": [
          "Table.SelectRows(stgVendas, each [DataVenda] <> null and [ItemID] <> \"\" and [PedidoID] <> \"\" and [ProdutoID] <> null and [UnidadeID] <> null and [CanalID] <> null and [Quantidade] <> null and [Quantidade] > 0 and [PrecoUnitario] <> null and [PrecoUnitario] >= 0 and [CustoUnitario] <> null and [CustoUnitario] >= 0 and [Desconto] <> null and [Desconto] >= 0 and [Desconto] <= [Quantidade] * [PrecoUnitario])"
        ]
      }
    ],
    "tables": [
      {
        "name": "DimUnidade",
        "columns": [
          {
