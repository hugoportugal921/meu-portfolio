              "expression": [
                "#table(type table [Valor = Int64.Type], {{0}})"
              ]
            }
          }
        ],
        "isHidden": false,
        "measures": [
          {
            "name": "Receita Bruta",
            "expression": [
              "SUMX(FatoVendas, FatoVendas[Quantidade] * FatoVendas[PrecoUnitario])"
            ],
            "formatString": "R$ #,##0.00;(R$ #,##0.00);R$ 0.00",
            "description": "Receita antes dos descontos.",
            "displayFolder": "Indicadores",
            "lineageTag": "18631494-79ae-5235-837c-be3e2f97d70b"
          },
          {
            "name": "Descontos",
            "expression": [
              "SUM(FatoVendas[Desconto])"
            ],
            "formatString": "R$ #,##0.00;(R$ #,##0.00);R$ 0.00",
            "description": "Desconto monetário do item, sem repetir por pedido.",
            "displayFolder": "Indicadores",
            "lineageTag": "4ef1a47c-4dbd-53bf-aef9-e77f451f1212"
          },
          {
            "name": "Receita Líquida",
            "expression": [
              "SUM(FatoVendas[ReceitaLiquida])"
            ],
            "formatString": "R$ #,##0.00;(R$ #,##0.00);R$ 0.00",
            "description": "Quantidade × preço unitário − desconto do item.",
            "displayFolder": "Indicadores",
            "lineageTag": "901a6db2-6fc2-5287-945b-9574b03e3b99"
          },
          {
            "name": "Custo das Vendas",
            "expression": [
              "SUM(FatoVendas[CustoTotal])"
            ],
            "formatString": "R$ #,##0.00;(R$ #,##0.00);R$ 0.00",
            "description": "Custo unitário × quantidade.",
            "displayFolder": "Indicadores",
            "lineageTag": "4d95c476-4ef0-50b9-b691-98985d4d97ea"
          },
          {
            "name": "Lucro Bruto",
            "expression": [
              "[Receita Líquida] - [Custo das Vendas]"
            ],
            "formatString": "R$ #,##0.00;(R$ #,##0.00);R$ 0.00",
            "description": "Receita líquida menos custo das mercadorias e serviços.",
            "displayFolder": "Indicadores",
            "lineageTag": "d75c8a45-12a5-587c-9fb1-d819e14fa8bb"
          },
          {
            "name": "Margem Bruta %",
            "expression": [
              "DIVIDE([Lucro Bruto], [Receita Líquida])"
            ],
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Margem calculada sobre os totais; não é média simples das margens.",
            "displayFolder": "Indicadores",
            "lineageTag": "532639d0-7d2a-5619-b5be-04f284b2eee2"
          },
          {
            "name": "Pedidos",
            "expression": [
              "DISTINCTCOUNT(FatoVendas[PedidoID])"
            ],
            "formatString": "#,##0",
            "description": "Pedidos distintos no contexto de filtros, sem duplicar itens.",
            "displayFolder": "Indicadores",
            "lineageTag": "83b9b694-3078-507a-90d8-e113d3387d35"
          },
          {
            "name": "Itens Vendidos",
            "expression": [
              "SUM(FatoVendas[Quantidade])"
            ],
            "formatString": "#,##0",
            "description": "Quantidade total de itens.",
            "displayFolder": "Indicadores",
            "lineageTag": "a0d6b6fe-fb69-535c-a003-b3de095c92a9"
          },
          {
            "name": "Ticket Médio",
            "expression": [
              "DIVIDE([Receita Líquida], [Pedidos])"
            ],
            "formatString": "R$ #,##0.00;(R$ #,##0.00);R$ 0.00",
            "description": "Receita líquida por pedido distinto no contexto atual.",
            "displayFolder": "Indicadores",
            "lineageTag": "f5efb6c0-9208-5f3b-a591-3345bc2bf247"
          },
          {
            "name": "Meta Receita",
            "expression": [
              "IF(ISCROSSFILTERED(DimProduto) || ISCROSSFILTERED(DimCanal), BLANK(), SUM(FatoMetas[MetaReceita]))"
            ],
            "formatString": "R$ #,##0.00;(R$ #,##0.00);R$ 0.00",
            "description": "A meta existe por mês e unidade. Filtros de produto ou canal deixam a meta indisponível.",
            "displayFolder": "Indicadores",
            "lineageTag": "451fa10b-05e4-554d-8203-5d63c7b399f7"
          },
          {
            "name": "Atingimento %",
            "expression": [
              "DIVIDE([Receita Líquida], [Meta Receita])"
            ],
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Realizado dividido pela meta compatível com os filtros.",
            "displayFolder": "Indicadores",
            "lineageTag": "30dd2384-ea31-5935-9594-d53c4315127c"
          },
          {
            "name": "Desvio da Meta",
            "expression": [
              "IF(NOT ISBLANK([Meta Receita]), [Receita Líquida] - [Meta Receita])"
            ],
            "formatString": "R$ #,##0.00;(R$ #,##0.00);R$ 0.00",
            "description": "Desvio absoluto, somente quando há meta comparável.",
            "displayFolder": "Indicadores",
            "lineageTag": "13ad649b-6397-5be1-a28e-6bf34f43f415"
          },
          {
            "name": "Receita Ano Anterior",
            "expression": [
              "VAR Inicio = MIN(DimCalendario[Data])",
              "VAR InicioBase = CALCULATE(MIN(DimCalendario[Data]), REMOVEFILTERS(DimCalendario))",
              "RETURN IF(DATE(YEAR(Inicio) - 1, MONTH(Inicio), DAY(Inicio)) >= InicioBase, CALCULATE([Receita Líquida], SAMEPERIODLASTYEAR(DimCalendario[Data])))"
            ],
            "formatString": "R$ #,##0.00;(R$ #,##0.00);R$ 0.00",
            "description": "Mesmo intervalo do ano anterior; vazio quando o início do histórico não cobre a comparação completa.",
            "displayFolder": "Indicadores",
            "lineageTag": "cc4eefe2-2712-5e01-b530-6268f2b108a3"
          },
          {
            "name": "Variação Anual %",
            "expression": [
              "VAR Anterior = [Receita Ano Anterior]",
              "RETURN IF(NOT ISBLANK(Anterior), DIVIDE([Receita Líquida] - Anterior, Anterior))"
            ],
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Comparação com ano anterior no mesmo contexto.",
            "displayFolder": "Indicadores",
            "lineageTag": "cd66a53e-f004-5bb6-a531-971475099859"
          },
          {
            "name": "Receita YTD",
            "expression": [
              "TOTALYTD([Receita Líquida], DimCalendario[Data])"
            ],
            "formatString": "R$ #,##0.00;(R$ #,##0.00);R$ 0.00",
            "description": "Acumulado no ano no contexto da dimensão de datas.",
            "displayFolder": "Indicadores",
            "lineageTag": "58c2c66e-0b6b-5b6e-970d-ea0a6a8b9a3d"
          },
          {
            "name": "Receita Mês Anterior",
            "expression": [
              "IF(HASONEVALUE(DimCalendario[AnoMes]), CALCULATE([Receita Líquida], DATEADD(DimCalendario[Data], -1, MONTH)))"
            ],
            "formatString": "R$ #,##0.00;(R$ #,##0.00);R$ 0.00",
            "description": "Disponível ao selecionar um único mês; vazio quando não existe histórico anterior.",
            "displayFolder": "Indicadores",
            "lineageTag": "7514fe5b-480f-5d67-ade5-26dce71254bd"
          },
          {
            "name": "Variação Mensal %",
            "expression": [
              "VAR Anterior = [Receita Mês Anterior]",
              "RETURN IF(NOT ISBLANK(Anterior), DIVIDE([Receita Líquida] - Anterior, Anterior))"
            ],
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Comparação com o período mensal anterior.",
            "displayFolder": "Indicadores",
            "lineageTag": "33836d13-0efb-506d-9840-d994f1e5502b"
          },
          {
            "name": "Unidade Selecionada",
            "expression": [
              "SELECTEDVALUE(DimUnidade[Unidade], \"Todas as unidades\")"
            ],
            "formatString": "@",
            "description": "Texto que identifica o filtro da unidade.",
            "displayFolder": "Indicadores",
            "lineageTag": "f0a28ee0-3a33-5a00-a227-d06fed54eef9"
          }
        ]
      }
    ],
