  "medidas": [
    {
      "nome": "Receita Bruta",
      "dax": "SUMX(FatoVendas, FatoVendas[Quantidade] * FatoVendas[PrecoUnitario])",
      "formato": "moeda",
      "definicao": "Receita antes dos descontos."
    },
    {
      "nome": "Descontos",
      "dax": "SUM(FatoVendas[Desconto])",
      "formato": "moeda",
      "definicao": "Desconto monetário do item, sem repetir por pedido."
    },
    {
      "nome": "Receita Líquida",
      "dax": "SUM(FatoVendas[ReceitaLiquida])",
      "formato": "moeda",
      "definicao": "Quantidade × preço unitário − desconto do item."
    },
    {
      "nome": "Custo das Vendas",
      "dax": "SUM(FatoVendas[CustoTotal])",
      "formato": "moeda",
      "definicao": "Custo unitário × quantidade."
    },
    {
      "nome": "Lucro Bruto",
      "dax": "[Receita Líquida] - [Custo das Vendas]",
      "formato": "moeda",
      "definicao": "Receita líquida menos custo das mercadorias e serviços."
    },
    {
      "nome": "Margem Bruta %",
      "dax": "DIVIDE([Lucro Bruto], [Receita Líquida])",
      "formato": "percentual",
      "definicao": "Margem calculada sobre os totais; não é média simples das margens."
    },
    {
      "nome": "Pedidos",
      "dax": "DISTINCTCOUNT(FatoVendas[PedidoID])",
      "formato": "inteiro",
      "definicao": "Pedidos distintos no contexto de filtros, sem duplicar itens."
    },
    {
      "nome": "Itens Vendidos",
      "dax": "SUM(FatoVendas[Quantidade])",
      "formato": "inteiro",
      "definicao": "Quantidade total de itens."
    },
    {
      "nome": "Ticket Médio",
      "dax": "DIVIDE([Receita Líquida], [Pedidos])",
      "formato": "moeda",
      "definicao": "Receita líquida por pedido distinto no contexto atual."
    },
    {
      "nome": "Meta Receita",
      "dax": "IF(ISCROSSFILTERED(DimProduto) || ISCROSSFILTERED(DimCanal), BLANK(), SUM(FatoMetas[MetaReceita]))",
      "formato": "moeda",
      "definicao": "A meta existe por mês e unidade. Filtros de produto ou canal deixam a meta indisponível."
    },
    {
      "nome": "Atingimento %",
      "dax": "DIVIDE([Receita Líquida], [Meta Receita])",
      "formato": "percentual",
      "definicao": "Realizado dividido pela meta compatível com os filtros."
    },
    {
      "nome": "Desvio da Meta",
      "dax": "IF(NOT ISBLANK([Meta Receita]), [Receita Líquida] - [Meta Receita])",
      "formato": "moeda",
      "definicao": "Desvio absoluto, somente quando há meta comparável."
    },
    {
      "nome": "Receita Ano Anterior",
      "dax": "VAR Inicio = MIN(DimCalendario[Data])\nVAR InicioBase = CALCULATE(MIN(DimCalendario[Data]), REMOVEFILTERS(DimCalendario))\nRETURN IF(DATE(YEAR(Inicio) - 1, MONTH(Inicio), DAY(Inicio)) >= InicioBase, CALCULATE([Receita Líquida], SAMEPERIODLASTYEAR(DimCalendario[Data])))",
      "formato": "moeda",
      "definicao": "Mesmo intervalo do ano anterior; vazio quando o início do histórico não cobre a comparação completa."
    },
    {
      "nome": "Variação Anual %",
      "dax": "VAR Anterior = [Receita Ano Anterior]\nRETURN IF(NOT ISBLANK(Anterior), DIVIDE([Receita Líquida] - Anterior, Anterior))",
      "formato": "percentual",
      "definicao": "Comparação com ano anterior no mesmo contexto."
    },
    {
      "nome": "Receita YTD",
      "dax": "TOTALYTD([Receita Líquida], DimCalendario[Data])",
      "formato": "moeda",
      "definicao": "Acumulado no ano no contexto da dimensão de datas."
    },
    {
      "nome": "Receita Mês Anterior",
      "dax": "IF(HASONEVALUE(DimCalendario[AnoMes]), CALCULATE([Receita Líquida], DATEADD(DimCalendario[Data], -1, MONTH)))",
      "formato": "moeda",
      "definicao": "Disponível ao selecionar um único mês; vazio quando não existe histórico anterior."
    },
    {
      "nome": "Variação Mensal %",
      "dax": "VAR Anterior = [Receita Mês Anterior]\nRETURN IF(NOT ISBLANK(Anterior), DIVIDE([Receita Líquida] - Anterior, Anterior))",
      "formato": "percentual",
      "definicao": "Comparação com o período mensal anterior."
    },
    {
      "nome": "Unidade Selecionada",
      "dax": "SELECTEDVALUE(DimUnidade[Unidade], \"Todas as unidades\")",
      "formato": "texto",
      "definicao": "Texto que identifica o filtro da unidade."
    }
  ]
}
