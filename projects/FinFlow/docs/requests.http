@transactions = http://localhost:5001
@ledger = http://localhost:5002
# Copy accessToken from the first response. Available only in Development.
POST {{transactions}}/dev/token

###
@token = PASTE_LOCAL_ACCESS_TOKEN
GET {{ledger}}/api/accounts/
Authorization: Bearer {{token}}

### Accepted (202); same key + same payload returns the same ID (200).
POST {{transactions}}/api/transfers/
Authorization: Bearer {{token}}
Content-Type: application/json
Idempotency-Key: b1bff50e-49a9-4df9-9206-95da43385d6e

{"sourceId":"11111111-1111-4111-8111-111111111111","targetId":"22222222-2222-4222-8222-222222222222","amountMinor":125000,"currency":"BRL"}

###
GET {{transactions}}/api/transfers/?limit=50
Authorization: Bearer {{token}}

###
GET {{ledger}}/api/accounts/11111111-1111-4111-8111-111111111111/entries
Authorization: Bearer {{token}}
